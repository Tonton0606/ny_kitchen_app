[Unit]
Description=N.Y Kitchen sales synchronization API
After=network.target

[Service]
User=nykitchen
Group=nykitchen
WorkingDirectory=/opt/ny-kitchen
EnvironmentFile=/etc/ny-kitchen/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ny-kitchen/backend/.venv/bin/uvicorn backend.app:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ny-kitchen
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
