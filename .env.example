# N.Y Kitchen POS - Environment Variables Template
# Copy this file to .env and replace placeholders with your actual configuration.
# DO NOT commit the .env file containing real keys or secrets to git.

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_DEVICE_SECRET=your-device-secret-placeholder


# Ubuntu sales synchronization. Leave disabled to retain existing Supabase mode.
# Set SYNC_BACKEND=ubuntu only after provisioning the server and device credential.
SYNC_BACKEND=supabase
BACKEND_URL=https://nykitchen.test
# Supply the generated device token locally once, then remove it after secure storage setup.
# BACKEND_DEVICE_TOKEN=

